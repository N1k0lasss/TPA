# Copiá este archivo como `.env` y ajustá los valores.
# En Windows:  Copy-Item .env.example .env
# En Linux/macOS:  cp .env.example .env

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Generá una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar-por-una-clave-segura
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Solo aplica cuando DJANGO_DEBUG=False
DJANGO_SECURE_SSL_REDIRECT=False

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=InvenShop <no-responder@invenshop.local>

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Opción 1: SQLite (recomendada para la entrega)
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# Opción 2: PostgreSQL (descomentá y completá)
# DB_ENGINE=postgres
# DB_NAME=invenshop
# DB_USER=invenshop
# DB_PASSWORD=cambiar
# DB_HOST=127.0.0.1
# DB_PORT=5432
